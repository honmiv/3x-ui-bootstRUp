{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 62789,
      "protocol": "tunnel",
      "settings": {
        "rewriteAddress": "127.0.0.1"
      },
      "tag": "api"
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs",
        "finalRules": [
          {
            "action": "block",
            "ip": [
              "geoip:private"
            ]
          },
          {
            "action": "allow"
          }
        ]
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "enabled": true,
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "enabled": true,
        "domain": [
          "ext:geosite-hydraponique.dat:win-spy",
          "ext:geosite-hydraponique.dat:torrent",
          "ext:geosite-hydraponique.dat:category-ads",
          "ext:geosite-hydraponique.dat:category-ru",
          "geosite:category-ru"
          "domain:trace-flow.ru",
          "domain:api.ipify.org",
          "domain:ifconfig.me",
          "domain:ip.mail.ru",
          "domain:ipv6-internet.yandex.net",
          "domain:ipv4-internet.yandex.net",
          "domain:internet.yandex.ru",
          "domain:internet.yandex.com",
          "domain:checkip.amazonaws.com",
          "domain:ipinfo.io",
          "domain:icanhazip.com",
          "domain:ident.me",
          "domain:ip-api.com",
          "domain:whatismyip.com",
          "domain:whatismyipaddress.com",
          "domain:iplocation.net",
          "domain:2ip.ru",
          "domain:2ip.io",
          "domain:whoer.net",
          "domain:myip.com",
          "domain:browserleaks.com",
          "domain:dnsleaktest.com",
          "domain:ipleak.net",
          "domain:ip.sb",
          "domain:myexternalip.com",
          "domain:wtfismyip.com",
          "domain:ipwho.is",
          "domain:ipapi.co",
          "domain:am.i.mullvad.net",
          "domain:myip.ru",
