services:
  3xui:
    image: 'ghcr.io/mhsanaei/3x-ui:3.2.5'
    container_name: 3xui
    restart: unless-stopped
    volumes:
      - ./working/db/:/etc/x-ui/
    environment:
      XRAY_VMESS_AEAD_FORCED: "false"
      XUI_ENABLE_FAIL2BAN: "true"
    ports:
      - "443:443"
    networks:
      - 3xui-caddy-net

  caddy:
    image: caddy:latest
    container_name: caddy
    restart: always
    volumes:
      - ./.caddy_data/data:/data
      - ./working/caddy-web-templates:/srv
      - ./working/Caddyfile:/etc/caddy/Caddyfile
    ports:
      - "80:80"
    networks:
      - 3xui-caddy-net

networks:
  3xui-caddy-net:
    driver: bridge
